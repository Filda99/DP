<?xml version="1.0" ?>
<robot name="plane">
  <link name="planeLink">
    <contact>
      <lateral_friction value="1.0"/>
      <rolling_friction value="0.0"/>
      <contact_cfm value="0.0"/>
      <contact_erp value="0.0"/>
    </contact>
    <inertial>
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
    <collision name="collision">
      <geometry>
        <plane normal="0 0 1" />
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box size="100 100 0.01" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 0.5" />
      </material>
    </visual>
  </link>
</robot>