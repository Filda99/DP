<?xml version="1.0"?>
<robot name="quadcopter">
  <!-- Main body -->
  <link name="base_link">
    <!-- Visual representation -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.373 0.282 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    
    <!-- Collision representation -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.373 0.282 0.1"/>
      </geometry>
    </collision>
    
    <!-- Inertial properties - based on Parrot ANAFI USA -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.496"/>  <!-- 496 grams -->
      
      <!-- Inertia tensor for rectangular body -->
      <!-- I = (1/12) * m * (h^2 + w^2) for box -->
      <inertia 
        ixx="0.0033"  <!-- (1/12) * 0.496 * (0.1^2 + 0.282^2) -->
        iyy="0.0061"  <!-- (1/12) * 0.496 * (0.1^2 + 0.373^2) -->
        izz="0.0090"  <!-- (1/12) * 0.496 * (0.373^2 + 0.282^2) -->
        ixy="0" 
        ixz="0" 
        iyz="0"/>
    </inertial>
  </link>
  
  <!-- Propeller 1 (front-right) -->
  <link name="prop_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.01"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  
  <!-- Propeller 2 (front-left) -->
  <link name="prop_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.01"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  
  <!-- Propeller 3 (rear-left) -->
  <link name="prop_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.01"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  
  <!-- Propeller 4 (rear-right) -->
  <link name="prop_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.01"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  
  <!-- Joints connecting propellers to main body -->
  <joint name="prop_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="prop_1"/>
    <origin xyz="0.186 -0.141 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <joint name="prop_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="prop_2"/>
    <origin xyz="0.186 0.141 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <joint name="prop_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="prop_3"/>
    <origin xyz="-0.186 0.141 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <joint name="prop_4_joint" type="continuous">
    <parent link="base_link"/>
    <child link="prop_4"/>
    <origin xyz="-0.186 -0.141 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
</robot>