graph TD
    %% Definice vstupů (Žlutá)
    LocalObs["Agent's Local Observation<br>(Decentralized State)"]
    Privileged["Privileged Extras<br>(True Fire X, Y, Intensity)<br>(Other Agents' X, Y, Z)"]

    %% Agregace
    Concat{"Concatenation"}

    %% Zpracování a vrstvy (Červená)
    MLP["MLP Encoder<br>(Linear + ReLU + Linear + ReLU)"]
    GRU["Gated Recurrent Unit (GRU)<br>Temporal Memory"]
    ValueHead["Value Head (Linear)"]

    %% Mezistavy a vektory (Modrá)
    GlobalState["Global State Vector<br>(1D Flattened Array)"]
    EncodedFeatures["Encoded Features"]

    %% Finální výstup (Zelená)
    Value["Value Function V(s)<br>(Single Scalar)"]

    %% Propojení
    LocalObs --> Concat
    Privileged --> Concat
    Concat --> GlobalState
    
    GlobalState --> MLP
    MLP --> EncodedFeatures
    EncodedFeatures --> GRU
    GRU --> ValueHead
    ValueHead --> Value

    %% Styling
    style LocalObs fill:#fff2cc,stroke:#d6b656
    style Privileged fill:#fff2cc,stroke:#d6b656
    style Concat fill:#f5f5f5,stroke:#666666
    style MLP fill:#f8cecc,stroke:#b85450
    style GRU fill:#f8cecc,stroke:#b85450
    style ValueHead fill:#f8cecc,stroke:#b85450
    style GlobalState fill:#dae8fc,stroke:#6c8ebf
    style EncodedFeatures fill:#dae8fc,stroke:#6c8ebf
    style Value fill:#d5e8d4,stroke:#82b366